#!/usr/bin/env python3
import argparse
import sys
import json
from eseo.loki.defaults import record_config as default_config

system_config_filename = "/media/data/config/loki-system-config.json"

parser = argparse.ArgumentParser()

parser.add_argument("key", type=str, help="The property to read")

args = parser.parse_args()

if args.key not in default_config:
    sys.stderr.write("Error - Invalid property name: '{}'\n".format(args.key))
    result = 0
else:
    result = default_config[args.key]

    try:
        with open(system_config_filename) as f:
            stored_config = json.load(f)

        if args.key in stored_config:
            result = stored_config[args.key]
    except FileNotFoundError:
        sys.stderr.write("Error - File not found: '{}'. Using default settings.\n".format(system_config_filename))
    except json.JSONDecodeError:
        sys.stderr.write("Error - Invalid JSON file: '{}'. Using default settings.\n".format(system_config_filename))

sys.stdout.write(str(result))
