#!/usr/bin/env python3
import argparse
from math import ceil, sqrt
from time import sleep
from eseo.loki.native import *
from eseo.loki.util import *
import eseo.loki.defaults

modem = LokiModem()

parser = argparse.ArgumentParser()

def bounded(t, a, b=None):
    def check(x):
        res = t(x)
        if res < a or (b is not None and res > b):
            raise argparse.ArgumentTypeError("Value out of bounds")
        return res
    return check

parser.add_argument("-c", "--channels", dest="stream_channels",
    type=bounded(int, -1, (1 << modem.get_demod_channels()) - 1), default=argparse.SUPPRESS,
    help="A mask that specifies the channels to record (default, -1 for all channels)")
parser.add_argument("-a", "--attempts",
    type=bounded(int, 0), default=100,
    help="The channel to record (default, -1 for all channels)")
parser.add_argument("-t", "--attempt-duration",
    type=bounded(float, 0.0), default=1.0,
    help="The recording duration for each attempt (seconds, defaults to 1 sec)")
parser.add_argument("-p", "--packet-length",
    type=bounded(int, 1), default=argparse.SUPPRESS,
    help="Number of samples per packet")
parser.add_argument("-e", "--ellipse-estimator",
    type=str, choices=["rls", "nlms", "kalman"], default=argparse.SUPPRESS,
    help="The adaptive filter to estimate ellipse parameters")
parser.add_argument("-r", "--ellipse-initial-radius",
    type=bounded(float, 0), default=argparse.SUPPRESS,
    help="The radius of the initial ellipse for the adaptive filter")
parser.add_argument("-P", "--ellipse-estimator-param",
    type=float, action="append",
    help="A parameter of the adaptive filter")
parser.add_argument("--load",
    type=str, default=argparse.SUPPRESS,
    help="Load configuration from file")

args = parser.parse_args()

system_config = LokiSystemConfig()

record_config = dict(eseo.loki.defaults.record_config)

if hasattr(args, "load"):
    load_system_config(system_config, record_config, args.load)

for name in record_config.keys():
    if hasattr(args, name):
        record_config[name] = getattr(args, name)

if hasattr(args, "ellipse_estimator"):
    system_config.set_estimator_name(args.ellipse_estimator)

if hasattr(args, "ellipse_initial_radius"):
    system_config.set_estimator_initial_radius(args.ellipse_initial_radius)

if args.ellipse_estimator_param is not None:
    for i, v in enumerate(args.ellipse_estimator_param):
        system_config.set_estimator_param(i, v)

system = LokiSystem(system_config, modem)

# Désactiver le mode bypass du modem.
modem.set_demod_bypass(False)

# Construire la liste des numéros de voies activées dans le masque stream_channels.
channels = []
for c in range(modem.get_demod_channels()):
    if record_config["stream_channels"] & (1 << c):
        channels.append(c)

xy_sample_size   = modem.get_sample_size()
disp_sample_size = system.get_sample_size()

fifo_length   = int(record_config["fifo_length"])
packet_length = int(record_config["packet_length"])

xy_fifo   = LokiFIFO(get_fifo_item_size(packet_length, xy_sample_size),   fifo_length)
disp_fifo = LokiFIFO(get_fifo_item_size(packet_length, disp_sample_size), fifo_length)

disp_consumer = LokiConsumer()
disp_consumer.start(disp_fifo)

def ellipse_area(channel, delay_x, delay_y):
    modem.set_demod_delay_x(channel, delay_x)
    modem.set_demod_delay_y(channel, delay_y)
    modem.restart()

    sleep(args.attempt_duration)

    ellipse = system.get_ellipse(channel)
    return ellipse.A * ellipse.B

def run(channel):
    delay_x_max = modem.get_demod_delay_x_max(channel)
    delay_y_max = modem.get_demod_delay_y_max(channel)

    best_delay_x = best_delay_y = 0
    best_area = -1.0

    for i in range(attempts * 2):
        if i < attempts:
            dx = round(i * delay_x_max / (attempts - 1))
            dy = 0
        else:
            dx = best_delay_x
            dy = round((i - attempts) * delay_y_max / (attempts - 1))

        area = ellipse_area(channel, dx, dy)
        up   = area > best_area
        if up:
            best_delay_x = dx
            best_delay_y = dy
            best_area    = area

        progress_percent = round(50 * (i + 1) / attempts)
        print("Channel {} [{}%] {}".format(channel, progress_percent, "+" if up else ""))

    print("Channel {}: best area={}, dx={}, dy={}".format(channel, best_area, best_delay_x, best_delay_y))

    modem.set_demod_delay_x(channel, best_delay_x)
    modem.set_demod_delay_y(channel, best_delay_y)

system.start_streaming(record_config["stream_channels"], xy_fifo, disp_fifo)

for c in channels:
    run(c)

disp_consumer.stop()
system.stop_streaming()
